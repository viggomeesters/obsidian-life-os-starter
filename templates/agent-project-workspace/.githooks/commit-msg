#!/usr/bin/env sh
set -eu

MSG_FILE="$1"

if git diff --cached --name-only | grep -qx "tasks.md"; then
  if git diff --cached -- tasks.md | grep -Eq '^\+.*-[[:space:]]+\[x\][[:space:]]+[A-Z0-9]+-T[0-9]{3}:'; then
    if ! grep -Eq '[A-Z0-9]+-T[0-9]{3}' "$MSG_FILE"; then
      echo "Commit message must include a task id such as {{PROJECT_CODE}}-T002 when completing a task." >&2
      exit 1
    fi
  fi
fi
