{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viggomeesters.github.io/vault-schema/vault-schema.contract.schema.json",
  "title": "Vault Schema Contract",
  "type": "object",
  "required": [
    "version",
    "updated",
    "enums",
    "core_fields",
    "context_fields",
    "folders",
    "note_intake",
    "anchor_contract",
    "filename_patterns",
    "types",
    "type_category_area",
    "db_columns"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "enums": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          ]
        }
      }
    },
    "core_fields": {
      "$ref": "#/$defs/fields"
    },
    "context_fields": {
      "$ref": "#/$defs/fields"
    },
    "folders": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "structure": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "lifecycle": {
            "type": "string"
          },
          "subfolders": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true,
        "anyOf": [
          {
            "required": [
              "structure",
              "purpose"
            ]
          },
          {
            "required": [
              "subfolders"
            ]
          }
        ]
      }
    },
    "note_intake": {
      "type": "object",
      "required": [
        "default_creation_location"
      ],
      "additionalProperties": true
    },
    "anchor_contract": {
      "type": "object",
      "required": [
        "new_or_changed_notes"
      ],
      "additionalProperties": true
    },
    "filename_patterns": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "location",
          "filename",
          "description",
          "categories"
        ],
        "properties": {
          "location": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "categories": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "type_category_area": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "allowed_areas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      }
    },
    "db_columns": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "required_new": {
            "type": "boolean"
          },
          "items": {
            "type": "string"
          },
          "enum": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
